  "cards": [
    {
      "id": "c01",
      "stage": "ideas",
      "title": "Campaign 01 · Introduction",
      "angle": "Who House of Navi is, and the first project we walk with.",
      "page": "carousel-01.html",
      "date": "",
      "notes": "",
      "tiles": [
        {
          "image": "MKASANGA PICS/LION CAMP_MKASAGA VILLAGE_COMMUNITY_HERO IMAGE.jpg",
          "kicker": "A spotlight · not a solution",
          "headline": "Stories can change the world.",
          "body": ""
        },
        {
          "image": "brand/assets/textures/texture-terracotta.png",
          "kicker": "Who we are",
          "headline": "A small house for big stories.",
          "body": "House of Navi is a South African non-profit. We shine a light on initiatives already creating change — and connect them to the people who want to carry them further."
        },
        {
          "image": "",
          "kicker": "Why it matters",
          "headline": "The world does not need more noise. It needs deeper connection.",
          "body": "We don't lead with statistics. We lead with the people on the ground, and the work already in motion — and we let the rest of the world catch up."
        },
        {
          "image": "MKASANGA PICS/LION CAMP_MKASAGA VILLAGE_COMMUNITY-14.jpg",
          "kicker": "№ 01 · Healthcare",
          "headline": "Mkasanga Community Clinic",
          "body": "Six to eight hours from the nearest hospital. Cut off entirely during the rains. Already half-built by the people who need it."
        },
        {
          "image": "MKASANGA PICS/LION CAMP_MKASAGA VILLAGE_COMMUNITY-26.jpg",
          "kicker": "Get involved",
          "headline": "Walk with us.",
          "body": "Support a project, partner with us, or simply pass the story on."
        }
      ]
    },
    {
      "id": "c02",
      "stage": "ideas",
      "title": "Campaign 02 · The Name",
      "angle": "What \"Navi\" means — three roots, one promise.",
      "page": "carousel-02.html",
      "date": "",
      "notes": "",
      "tiles": [
        {
          "image": "brand/assets/textures/texture-footsteps-sand.png",
          "kicker": "A name is a promise",
          "headline": "Every name carries a story.",
          "body": "Ours carries three."
        },
        {
          "image": "",
          "kicker": "The word",
          "headline": "Navi",
          "body": "Three languages, one quiet instruction — speak for those who go unheard."
        },
        {
          "image": "brand/assets/textures/TEXTURE WOOD.png",
          "kicker": "Three roots",
          "headline": "Hebrew · Sanskrit · Na'vi",
          "body": "Prophet. New. Of the land. Speak — renew — belong."
        },
        {
          "image": "MKASANGA PICS/LION CAMP_MKASAGA VILLAGE_COMMUNITY_HERO IMAGE.jpg",
          "kicker": "The one that stuck",
          "headline": "A prophet isn't a fortune-teller. It's someone who gives voice to the unseen.",
          "body": "— what Navi means to us"
        },
        {
          "image": "brand/assets/textures/texture-knuckles.jpg",
          "kicker": "Where we come from",
          "headline": "We come from the agency world.",
          "body": "Brand, film, story — the craft that makes people stop and look. We took those tools off the billboard and pointed them at the work that actually matters."
        },
        {
          "image": "MKASANGA PICS/LION CAMP_MKASAGA VILLAGE_COMMUNITY-12.jpg",
          "kicker": "Why it matters",
          "headline": "The work leaves no time to be heard.",
          "body": "The people on the ground are consumed by what's urgent — the clinic, the rains, the next season. Telling the world rarely makes the list. So we hold the magnifying glass over quiet, noble work, and let it speak."
        },
        {
          "image": "MKASANGA PICS/LION CAMP_MKASAGA VILLAGE_COMMUNITY-24.jpg",
          "kicker": "Walk with us",
          "headline": "Hold the light with us.",
          "body": "Follow the stories, share the work, or help fund the people doing it. Every bit of attention is a spotlight."
        }
      ]
    }
  ]
}